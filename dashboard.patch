index 0000000..e518293
--- /dev/null
+++ b/frontend/src/components/dashboard/ProductJourneySection.css
@@ -0,0 +1,323 @@
+/* Product Journey Stepper Stylesheet */
+@import "../../styles/variables.css";
+
+.product-journey-section-root {
+  margin-bottom: 2.25rem;
+  width: 100%;
+  box-sizing: border-box;
+}
+
+.journey-section-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: 1.25rem;
+  flex-wrap: wrap;
+  gap: 12px;
+}
+
+.journey-title-group h2 {
+  font-size: 1.25rem;
+  font-weight: 700;
+  margin: 0;
+  color: var(--color-text-primary-dark, #F1F5F9);
+}
+
+.journey-title-group p {
+  font-size: 0.875rem;
+  color: var(--color-text-secondary-dark, #CBD5E1);
+  margin: 4px 0 0 0;
+}
+
+.btn-journey-info-toggle {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  background: rgba(255, 255, 255, 0.08);
+  border: 1px solid var(--color-border-dark, #2A3441);
+  color: var(--color-text-primary-dark, #F1F5F9);
+  padding: 0.4rem 0.9rem;
+  border-radius: var(--radius-full, 9999px);
+  font-size: 0.78rem;
+  font-weight: 600;
+  cursor: pointer;
+  transition: all 0.15s ease;
+}
+
+.btn-journey-info-toggle:hover {
+  background: rgba(255, 255, 255, 0.15);
+  border-color: var(--color-primary-dark, #818CF8);
+  color: #FFFFFF;
+}
+
+.journey-explanation-card {
+  background: var(--color-card-dark, #1A2233);
+  border: 1px solid var(--color-border-dark, #2A3441);
+  border-radius: var(--radius-xl, 16px);
+  padding: 1.25rem;
+  margin-bottom: 1.5rem;
+  font-size: 0.85rem;
+  color: var(--color-text-primary-dark, #F1F5F9);
+  box-shadow: var(--shadow-md, 0 4px 8px rgba(0, 0, 0, 0.2));
+  animation: fadeIn 0.2s ease-in-out;
+}
+
+.journey-explanation-card ul {
+  margin: 8px 0 0 1.25rem;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.journey-explanation-card li strong {
+  color: #FFFFFF;
+}
+
+/* Stepper <ol> Grid */
+.journey-stepper-list {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: 1rem;
+  list-style: none;
+  padding: 0;
+  margin: 0;
+}
+
+.journey-step-item {
+  display: flex;
+  position: relative;
+}
+
+.step-card-content {
+  width: 100%;
+  border-radius: var(--radius-xl, 16px);
+  padding: 1.15rem;
+  background: var(--color-card-dark, #1A2233);
+  border: 1px solid var(--color-border-dark, #2A3441);
+  display: flex;
+  flex-direction: column;
+  justify-content: space-between;
+  gap: 0.75rem;
+  transition: all 0.2s ease;
+  box-sizing: border-box;
+  opacity: 1; /* Explicit full opacity — no washed out fading */
+}
+
+.step-card-content.interactive {
+  cursor: pointer;
+}
+
+.step-card-content.interactive:hover {
+  transform: translateY(-2px);
+  border-color: var(--color-primary-dark, #818CF8);
+  box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.5);
+}
+
+.step-card-content.interactive:focus-visible {
+  outline: none;
+  border-color: var(--color-primary-dark, #818CF8);
+  box-shadow: 0 0 0 3px rgba(129, 140, 248, 0.35);
+}
+
+.step-card-content.disabled {
+  opacity: 1; /* Full opacity ensures text remains sharp and readable */
+  cursor: not-allowed;
+  background: var(--color-surface-dark, #111827);
+  border: 1px dashed var(--color-border-dark, #2A3441);
+}
+
+/* Status variants */
+.journey-step-item.current .step-card-content {
+  border-color: var(--color-primary-dark, #818CF8);
+  background: linear-gradient(135deg, rgba(79, 70, 229, 0.18), var(--color-card-dark, #1A2233));
+  box-shadow: 0 0 0 1px var(--color-primary-dark, #818CF8), 0 8px 20px rgba(79, 70, 229, 0.2);
+}
+
+.journey-step-item.done .step-card-content {
+  border-color: var(--color-success, #16A34A);
+}
+
+.step-indicator-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+}
+
+.step-number-pill {
+  width: 24px;
+  height: 24px;
+  border-radius: 50%;
+  background: rgba(255, 255, 255, 0.12);
+  color: var(--color-text-primary-dark, #F1F5F9);
+  font-size: 0.75rem;
+  font-weight: 700;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.journey-step-item.current .step-number-pill {
+  background: var(--color-primary, #4F46E5);
+  color: #FFFFFF;
+}
+
+.journey-step-item.done .step-number-pill {
+  background: var(--color-success, #16A34A);
+  color: #FFFFFF;
+}
+
+.step-main-info {
+  display: flex;
+  align-items: flex-start;
+  gap: 10px;
+}
+
+.step-icon-badge {
+  font-size: 1.35rem;
+  line-height: 1;
+}
+
+.step-label-group {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  min-width: 0;
+}
+
+.step-label-title {
+  font-size: 0.95rem;
+  font-weight: 700;
+  color: var(--color-text-primary-dark, #F1F5F9);
+  margin: 0;
+}
+
+.step-hint-text {
+  font-size: 0.75rem;
+  color: var(--color-text-secondary-dark, #CBD5E1);
+  margin: 0;
+  line-height: 1.35;
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+
+.step-cta-hint {
+  font-size: 0.75rem;
+  font-weight: 600;
+  color: var(--color-primary-dark, #818CF8);
+  padding-top: 0.5rem;
+  border-top: 1px solid var(--color-border-dark, #2A3441);
+}
+
+.journey-step-item.done .step-cta-hint {
+  color: var(--color-success-dark, #4ADE80);
+}
+
+/* ==========================================================================
+   Light Theme Support
+   ========================================================================== */
+.dashboard-root.light .journey-title-group h2 {
+  color: var(--color-text-primary, #0F172A);
+}
+
+.dashboard-root.light .journey-title-group p {
+  color: var(--color-text-secondary, #475569);
+}
+
+.dashboard-root.light .btn-journey-info-toggle {
+  background: var(--color-surface, #F8FAFC);
+  border-color: var(--color-border, #E2E8F0);
+  color: var(--color-text-secondary, #475569);
+}
+
+.dashboard-root.light .btn-journey-info-toggle:hover {
+  background: #FFFFFF;
+  border-color: var(--color-primary, #4F46E5);
+  color: var(--color-primary, #4F46E5);
+}
+
+.dashboard-root.light .journey-explanation-card {
+  background: #FFFFFF;
+  border-color: var(--color-border, #E2E8F0);
+  color: var(--color-text-primary, #0F172A);
+  box-shadow: var(--shadow-sm, 0 1px 2px rgba(15, 23, 42, 0.06));
+}
+
+.dashboard-root.light .journey-explanation-card li strong {
+  color: var(--color-text-primary, #0F172A);
+}
+
+.dashboard-root.light .step-card-content {
+  background: var(--color-card, #FFFFFF);
+  border-color: var(--color-border, #E2E8F0);
+  box-shadow: var(--shadow-card, 0 2px 6px rgba(15, 23, 42, 0.06));
+}
+
+.dashboard-root.light .step-card-content.interactive:hover {
+  border-color: var(--color-primary, #4F46E5);
+  box-shadow: var(--shadow-lg, 0 8px 24px rgba(15, 23, 42, 0.10));
+}
+
+.dashboard-root.light .step-card-content.disabled {
+  background: var(--color-surface, #F8FAFC);
+  border-color: var(--color-border-strong, #CBD5E1);
+}
+
+.dashboard-root.light .journey-step-item.current .step-card-content {
+  border-color: var(--color-primary, #4F46E5);
+  background: linear-gradient(135deg, var(--color-primary-subtle, #EEF2FF), #FFFFFF);
+  box-shadow: 0 0 0 1px var(--color-primary, #4F46E5), var(--shadow-md, 0 4px 8px rgba(79, 70, 229, 0.1));
+}
+
+.dashboard-root.light .journey-step-item.done .step-card-content {
+  border-color: var(--color-success, #16A34A);
+}
+
+.dashboard-root.light .step-number-pill {
+  background: var(--color-border, #E2E8F0);
+  color: var(--color-text-secondary, #475569);
+}
+
+.dashboard-root.light .journey-step-item.current .step-number-pill {
+  background: var(--color-primary, #4F46E5);
+  color: #FFFFFF;
+}
+
+.dashboard-root.light .journey-step-item.done .step-number-pill {
+  background: var(--color-success, #16A34A);
+  color: #FFFFFF;
+}
+
+.dashboard-root.light .step-label-title {
+  color: var(--color-text-primary, #0F172A);
+}
+
+.dashboard-root.light .step-hint-text {
+  color: var(--color-text-secondary, #475569);
+}
+
+.dashboard-root.light .step-cta-hint {
+  color: var(--color-primary, #4F46E5);
+  border-top-color: var(--color-border, #E2E8F0);
+}
+
+.dashboard-root.light .journey-step-item.done .step-cta-hint {
+  color: var(--color-success, #16A34A);
+}
+
+/* Mobile & Tablet Responsiveness: Vertical Stepper */
+@media (max-width: 1024px) {
+  .journey-stepper-list {
+    grid-template-columns: repeat(2, 1fr);
+  }
+}
+
+@media (max-width: 640px) {
+  .journey-stepper-list {
+    grid-template-columns: 1fr;
+    gap: 0.75rem;
+  }
+}
