+export const calculateJourney = ({ user, primaryPortfolio, counts, profileStrength }) => {
+  const steps = [
+    {
+      key: "profile",
+      label: "Profile",
+      isDone: (profileStrength?.percentage || 0) >= 50,
+      isComingSoon: false,
+      route: "/dashboard/profile",
